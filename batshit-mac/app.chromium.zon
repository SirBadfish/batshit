.{
    .id = "ai.batshit.mac.chromium",
    .name = "batshit-chromium",
    .display_name = "Batshit Chromium",
    .version = "0.1.0",
    .icons = .{ "assets/icon.icns" },
    .platforms = .{ "macos" },
    .permissions = .{ "microphone" },
    .capabilities = .{ "webview", "js_bridge" },
    .bridge = .{
        .commands = .{
            .{ .name = "batshit.runtime.status", .origins = .{ "zero://app", "http://localhost:5620", "http://127.0.0.1:5620", "http://localhost:5640", "http://127.0.0.1:5640" } },
            .{ .name = "batshit.runtime.doctor", .origins = .{ "zero://app", "http://localhost:5620", "http://127.0.0.1:5620", "http://localhost:5640", "http://127.0.0.1:5640" } },
            .{ .name = "batshit.runtime.start", .origins = .{ "zero://app", "http://localhost:5620", "http://127.0.0.1:5620", "http://localhost:5640", "http://127.0.0.1:5640" } },
            .{ .name = "batshit.runtime.stop", .origins = .{ "zero://app", "http://localhost:5620", "http://127.0.0.1:5620", "http://localhost:5640", "http://127.0.0.1:5640" } },
            .{ .name = "batshit.runtime.restart", .origins = .{ "zero://app", "http://localhost:5620", "http://127.0.0.1:5620", "http://localhost:5640", "http://127.0.0.1:5640" } },
            .{ .name = "batshit.runtime.appleContainerStart", .origins = .{ "zero://app", "http://localhost:5620", "http://127.0.0.1:5620", "http://localhost:5640", "http://127.0.0.1:5640" } },
            .{ .name = "zero-native.dialog.saveFile", .origins = .{ "zero://app", "http://localhost:5620", "http://127.0.0.1:5620", "http://localhost:5640", "http://127.0.0.1:5640" } },
        },
    },
    .frontend = .{
        .dist = "frontend/dist",
        .entry = "index.html",
        .spa_fallback = true,
        .dev = .{
            .url = "http://localhost:5173/",
            .command = .{
                "npm",
                "--prefix",
                "frontend",
                "run",
                "dev",
            },
            .ready_path = "/",
            .timeout_ms = 30000,
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{
                "zero://app",
                "zero://inline",
                "http://127.0.0.1:5620",
                "http://localhost:5620",
                "http://127.0.0.1:5640",
                "http://localhost:5640",
            },
            .external_links = .{
                .action = "open_system_browser",
                .allowed_urls = .{ "https://*", "http://*" },
            },
        },
    },
    .web_engine = "chromium",
    .cef = .{ .dir = "third_party/cef/macos", .auto_install = false },
    .windows = .{
        .{ .label = "main", .title = "Batshit Chromium", .width = 1280, .height = 820, .restore_state = true },
    },
}
