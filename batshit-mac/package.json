{
  "name": "batshit-mac",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Electron shell for the Batshit Mac app.",
  "type": "module",
  "main": "src-electron/main.mjs",
  "scripts": {
    "doctor": "node scripts/electron-shell-doctor.mjs",
    "shell": "npm --prefix frontend run build && electron .",
    "shell:dev": "npm --prefix frontend run build && BATSHIT_MAC_ENABLE_DEVTOOLS=1 electron .",
    "runtime:status": "node scripts/mac-runtime-supervisor.mjs status",
    "runtime:doctor": "node scripts/mac-runtime-supervisor.mjs doctor",
    "runtime:start": "node scripts/mac-runtime-supervisor.mjs start",
    "runtime:stop": "node scripts/mac-runtime-supervisor.mjs stop",
    "runtime:apple-container:start": "node scripts/mac-runtime-supervisor.mjs apple-container-start",
    "prepare:managed-runtimes": "node scripts/prepare-managed-runtime-assets.mjs",
    "test": "npm run test:runtime",
    "test:runtime": "node --test scripts/*.test.mjs src-electron/*.test.mjs",
    "package:mac": "node scripts/package-mac-app.mjs",
    "package:dmg": "node scripts/package-release-dmg.mjs",
    "package:dmg:check": "node scripts/package-release-dmg.mjs --check",
    "package:zip": "ditto -c -k --sequesterRsrc --keepParent electron-out/package/Batshit.app electron-out/package/Batshit-0.1.0-macos-ReleaseSafe.zip",
    "package:audit": "node scripts/mac-runtime-supervisor.mjs package-audit electron-out/package/Batshit.app",
    "proof:apple-container-sandbox": "node scripts/prove-apple-container-sandbox.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "2.6.0",
    "@electron/packager": "20.2.0",
    "electron": "43.3.0"
  }
}
