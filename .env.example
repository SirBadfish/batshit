# Batshit Root Environment Example
# Copy to .env and adjust for your machine.

NODE_ENV=development

# Redis 8 (must provide the JSON module — Batshit stores every record as RedisJSON)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Local service ports
BATSHIT_FRONTEND_HOST=127.0.0.1
BATSHIT_FRONTEND_PORT=5621
N8N_BATSHIT_FRONTEND_URL=http://127.0.0.1:5621
BATSHIT_SERVER_PORT=5610
BATSHIT_MCP_STREAMABLE_PORT=5611
BATSHIT_SERVER_URL=http://localhost:5610
BATSHIT_SERVER_API_URL=http://localhost:5610/api/v1
PUBLIC_BATSHIT_SERVER_URL=http://localhost:5610
PUBLIC_BATSHIT_SERVER_API_URL=http://localhost:5610/api/v1
BATSHIT_ARTIFACT_COMPLETE_URL=http://localhost:5621/api/artifacts/complete

# In-app update notices. Source-checkout dev runs use the same alpha version
# default as packaged builds unless you override it here for local testing.
BATSHIT_APP_VERSION=0.1.0-alpha.1
BATSHIT_APP_CHANNEL=alpha
BATSHIT_UPDATE_CHECK_DISABLED=0
BATSHIT_UPDATE_FEED_URL=
BATSHIT_UPDATE_LATEST_VERSION=
BATSHIT_UPDATE_RELEASE_URL=
BATSHIT_UPDATE_DOWNLOAD_URL=

# Required before saving API keys/secrets in Settings.
ENCRYPTION_KEY=replace-with-a-long-stable-secret-at-least-32-chars

# Internal service token shared by Batshit app, batshit-server, and n8n tools.
BATSHIT_TOKEN=replace-with-a-long-random-token

# Logging
BATSHIT_LOG_LEVEL=info
BATSHIT_HTTP_LOGS=true
VITE_LOG_LEVEL=info
VITE_DEBUG_MODE=true
REDIS_LOG_LEVEL=info

# Optional Docker MCP Gateway companion. Leave blank unless you intentionally
# want the source-checkout private launcher to start a host Docker MCP Gateway.
DOCKER_MCP_GATEWAY_URL=
DOCKER_MCP_GATEWAY_PORT=
DOCKER_MCP_PROFILE=
# MCP_GATEWAY_AUTH_TOKEN=replace-with-secure-token

# Internal Dev panel. Public installs should leave this disabled.
BATSHIT_ENABLE_INTERNAL_DEV_PANEL=0
BATSHIT_INTERNAL_DEV_PANEL_SECRET=

# Optional CLI provider controls. Providers are enabled by default when the
# matching CLI is installed/authenticated; set either value to false to hide it.
BATSHIT_CODEX_PROVIDER_ENABLED=true
BATSHIT_CLAUDE_PROVIDER_ENABLED=true
# BATSHIT_CODEX_CLI_PATH=
# BATSHIT_CLAUDE_CLI_PATH=
# Proactive managed-CLI context guards default to 0.8. Use a value from 0.5
# (inclusive) to 1 (exclusive), or off/false/disabled/none/0 to disable.
# Invalid values fail the run before the CLI starts.
# BATSHIT_CODEX_CONTEXT_GUARD_THRESHOLD=0.8
# BATSHIT_CLAUDE_CONTEXT_GUARD_THRESHOLD=0.8
