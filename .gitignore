# Batshit public repository gitignore

# Environment files (API keys, secrets)
.env
.env.*
!.env.example
!.env.docker.example
.env.litellm

# OS files
.DS_Store
Thumbs.db

# SSL certificates
ssl/
*.crt
*.key
*.pem

# Node dependencies
node_modules/
**/node_modules/

# Logs and process files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# Runtime data and uploads
batshit-server/server/uploads/
batshit-server/server/data/
data/
**/data/postgres/
**/data/redis/

# Local-only workspace data
_local/
@ignore/
.agents/
.claude/
.codex/

# External local support folders
/n8n/
n8n-mcp/
vercel-ai-sdk-mcp-server/
mcp-redis/

# Build artifacts and caches
**/.svelte-kit/
**/build/
**/dist/
**/.output/
**/.vercel/
**/.netlify/
coverage/
**/.cache/
tmp/
temp/

# Generated assets
batshit-app/static/ai-branding-generated/

# Workspace/editor files
.impeccable/
.rgignore
batshit.code-workspace
*.code-workspace

# Agent Browser upload artifacts
agentbrowser_*

# Stale/orphaned root files
ai-agent-node.json
debug.log
