        "thresholds": [
          "BLOCK_NONE",
          "BLOCK_ONLY_HIGH",
          "BLOCK_MEDIUM_AND_ABOVE",
          "BLOCK_LOW_AND_ABOVE"
        ],
        "default": "BLOCK_MEDIUM_AND_ABOVE"
      }
    },
