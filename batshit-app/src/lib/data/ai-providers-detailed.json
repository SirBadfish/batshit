        "step": 0.1
      },
      "seed": {
        "type": "integer",
        "optional": true
      },
      "stopSequences": {
        "type": "array",
        "optional": true
      }
    },
    "credentials": "ollamaApi",
    "supportsBaseURL": true,
    "defaultBaseURL": "http://localhost:11434"
