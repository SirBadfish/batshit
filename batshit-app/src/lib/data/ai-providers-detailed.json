{
  "openai": {
    "displayName": "OpenAI",
    "n8nNode": "lmChatOpenAi",
    "models": {
      "dynamic": true,
      "endpoint": "/v1/models",
      "defaults": [
        "gpt-4o",
        "gpt-4o-mini",
        "gpt-4-turbo",
        "gpt-3.5-turbo"
      ]
    },
    "settings": {
      "temperature": {
        "min": 0,
        "max": 2,
        "default": 0.7,
        "step": 0.1
      },
      "maxTokens": {
        "min": -1,
        "max": 32768,
        "default": -1
      },
      "topP": {
        "min": 0,
        "max": 1,
        "default": 1,
        "step": 0.1
      },
      "frequencyPenalty": {
        "min": -2,
        "max": 2,
        "default": 0,
        "step": 0.1
      },
      "presencePenalty": {
        "min": -2,
        "max": 2,
        "default": 0,
        "step": 0.1
      },
      "responseFormat": {
        "options": [
          "text",
          "json_object"
        ],
        "default": "text"
      },
      "reasoningEffort": {
        "options": [
          "low",
          "medium",
          "high"
        ],
        "default": "medium",
        "showFor": [
          "o1",
          "o3"
        ]
      },
      "seed": {
        "type": "integer",
        "optional": true
      },
      "stopSequences": {
        "type": "array",
        "optional": true
      }
    },
    "credentials": "openAiApi",
    "supportsBaseURL": true
  },
  "anthropic": {
    "displayName": "Anthropic",
