+/**
+ * Batshit portable Node runtime contract. Deployment configuration is authority;
+ * request Host/forwarded headers never select a configured canonical origin.
+ */
+function parse_origin(value, label) {
+	if (value === undefined) return undefined;
+	const fail = () => { throw new Error(`${label} must be an absolute HTTP(S) origin without credentials, path, query, fragment, whitespace or backslashes`); };
+	if (typeof value !== 'string' || !value || value !== value.trim() || /[\u0000-\u0020\u007f\\]/.test(value)) fail();
+	const authority = /^https?:\/\/([^/?#]+)\/?$/i.exec(value)?.[1];
+	if (!authority || authority.includes('@') || authority.endsWith(':')) fail();
+	let url;
+	try { url = new URL(value); } catch { fail(); }
+	if (!['http:', 'https:'].includes(url.protocol) || !url.hostname || url.username || url.password || url.pathname !== '/' || url.search || url.hash || url.port === '0') fail();
+	return url.origin;
+}
+
+/** Preserve explicit build authority and refuse split application/adapter config. */
+export function resolve_origin(build_origin, runtime_origin, application_origin) {
+	const configured = parse_origin(build_origin, 'paths.origin');
+	const runtime = parse_origin(runtime_origin, 'ORIGIN');
+	const application = parse_origin(application_origin, 'Application ORIGIN');
+	const selected = configured ?? runtime ?? application;
+	if ([configured, runtime, application].some((value) => value !== undefined && value !== selected)) {
+		throw new Error('paths.origin and runtime/application ORIGIN conflict; configure one canonical origin');
+	}
+	return selected;
+}
