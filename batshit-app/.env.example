# Batshit Environment Variables

# Single-user instance identity.
BATSHIT_USER_ID=user_default

# Optional CLI provider controls. Providers are enabled by default when the
# matching CLI is installed/authenticated; set either value to false to hide it.
BATSHIT_CODEX_PROVIDER_ENABLED=true
BATSHIT_CLAUDE_PROVIDER_ENABLED=true
# BATSHIT_CODEX_CLI_PATH=
# BATSHIT_CLAUDE_CLI_PATH=
# BATSHIT_CODEX_CONTEXT_GUARD_THRESHOLD=0.8
# BATSHIT_CLAUDE_CONTEXT_GUARD_THRESHOLD=0.8

# Optional future auth (not used yet)
# BATSHIT_AUTH_USER=
# BATSHIT_AUTH_PASSWORD=

# Required before saving API keys/secrets in Settings. Keep stable across restarts.
ENCRYPTION_KEY=replace-with-a-long-stable-secret-at-least-32-chars

# Uses Vercel AI SDK Brain for all AI operations
USE_VERCEL_BRAIN=true

# Pulls Batshit Registry data
BATSHIT_MODEL_CATALOG_URL=https://api.batshit.ai/registry/catalog.json

# AI provider API keys (server-side only)
# These can also be saved per-user in Batshit Settings, but env keys work fine for local development.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional override for Anthropic API version header (defaults to 2023-06-01)
# ANTHROPIC_VERSION=2023-06-01
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
MOONSHOT_API_KEY=
# Optional Moonshot/Kimi base URL (defaults to https://api.moonshot.ai/v1)
# MOONSHOT_API_BASE_URL=https://api.moonshot.ai/v1
MINIMAX_API_KEY=
# Optional MiniMax base URL (defaults to https://api.minimax.io/v1)
# MINIMAX_API_BASE_URL=https://api.minimax.io/v1
MIMO_API_KEY=
# Optional MiMo base URL (defaults to https://api.xiaomimimo.com/v1)
# MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1
ALIBABA_CLOUD_API_KEY=
# DASHSCOPE_API_KEY is also accepted for Alibaba Cloud Model Studio / DashScope.
DASHSCOPE_API_KEY=
# Optional Alibaba base URLs.
# ALIBABA_CLOUD_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# ALIBABA_CLOUD_TTS_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# DASHSCOPE_TTS_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
STEPFUN_API_KEY=
# STEP_API_KEY is also accepted for StepFun.
STEP_API_KEY=
# Optional StepFun base URL (defaults to https://api.stepfun.ai/v1)
# STEPFUN_API_BASE_URL=https://api.stepfun.ai/v1
DEEPSEEK_API_KEY=
# Optional DeepSeek base URL (defaults to https://api.deepseek.com)
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
ZAI_API_KEY=
ZAI_CODING_API_KEY=
# Optional Z.ai base URLs (defaults to https://api.z.ai/api/paas/v4 and https://api.z.ai/api/coding/paas/v4)
# ZAI_API_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_CODING_API_BASE_URL=https://api.z.ai/api/coding/paas/v4
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
BASETEN_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
# Optional OpenAI-compatible base URLs for multi-tenant providers
# DEEPINFRA_API_BASE_URL=https://api.deepinfra.com/v1
# TOGETHER_API_BASE_URL=https://api.together.xyz/v1
# FIREWORKS_API_BASE_URL=https://api.fireworks.ai/inference/v1
# BASETEN_API_BASE_URL=https://inference.baseten.co/v1
# CEREBRAS_API_BASE_URL=https://api.cerebras.ai/v1
# COHERE_API_BASE_URL=https://api.cohere.ai/compatibility/v1

# Optional voice provider env fallbacks. Settings -> API Keys is preferred for normal use.
FISH_AUDIO_API_KEY=
INWORLD_API_KEY=
CARTESIA_API_KEY=
ASYNC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional enrichment (used by model catalog sync)
ARTIFICIAL_ANALYSIS_API_KEY=

# Vercel AI Gateway (optional, but recommended if you use the gateway connection)
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=

# n8n API access (used for workflow discovery + compatibility sync)
# Optional Batshit-side n8n API/MCP features. Users can also save these in
# Settings -> API Keys. n8n Primary/Subagent tool calls use the Batshit HTTP
# tools node and internal token instead.
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
# Optional UI login for parameter discovery (Sync n8n params)
N8N_UI_EMAIL=
N8N_UI_PASSWORD=

# Registry upload (only needed if you run model catalog sync / registry endpoints)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Redis connection (local)
REDIS_URL=redis://localhost:6379

# Local runtime URLs
BATSHIT_FRONTEND_HOST=127.0.0.1
BATSHIT_FRONTEND_PORT=5621
N8N_BATSHIT_FRONTEND_URL=http://127.0.0.1:5621
BATSHIT_SERVER_URL=http://localhost:5610
BATSHIT_SERVER_API_URL=http://localhost:5610/api/v1
PUBLIC_BATSHIT_SERVER_URL=http://localhost:5610
PUBLIC_BATSHIT_SERVER_API_URL=http://localhost:5610/api/v1

# HTTPS configuration
VITE_ENABLE_HTTPS=true

# Set to false to see all browser warnings (useful for debugging)
VITE_SUPPRESS_WARNINGS=true

# Batshit internal auth token (used by internal CLI helper tools + batshit-server bridges)
BATSHIT_TOKEN=replace-with-a-long-random-token
BATSHIT_ARTIFACT_COMPLETE_URL=http://localhost:5621/api/artifacts/complete

# Internal Dev panel. Public installs should leave this disabled.
# When enabled, BATSHIT_INTERNAL_DEV_PANEL_SECRET must be at least 32 characters.
BATSHIT_ENABLE_INTERNAL_DEV_PANEL=0
BATSHIT_INTERNAL_DEV_PANEL_SECRET=
