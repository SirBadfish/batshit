{
	"extends": "$app/tsconfig",
	"include": ["src/**/*.js", "src/**/*.ts", "src/**/*.svelte", "vite.config.js", "vite.config.ts"],
	"compilerOptions": {
		"paths": { "$lib": ["./src/lib"], "$lib/*": ["./src/lib/*"] },
		// === JavaScript Support ===
		"allowJs": true,
		"checkJs": true,

		// === Strict Type Checking (Professional Standards) ===
		"strict": true,
		"noUnusedLocals": false, // Can be noisy in Svelte with $state - disabled
		"noUnusedParameters": false, // Can be noisy with event handlers - disabled
		"noImplicitReturns": false, // Svelte components don't always return - disabled
		"noFallthroughCasesInSwitch": true,

		// === Module Resolution ===
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"moduleResolution": "bundler",

		// === Other Settings ===
		"skipLibCheck": true,
		"sourceMap": true
	},
	// Exclude test files from type checking (focus on production code)
	"exclude": [
		"node_modules/**",
		"src/service-worker.js",
		"src/service-worker/**/*.js",
		"src/service-worker.ts",
		"src/service-worker/**/*.ts",
		"src/service-worker.d.ts",
		"src/service-worker/**/*.d.ts",
		"**/*.test.ts",
		"**/*.test.js",
		"**/*.spec.ts",
		"**/*.spec.js",
		"**/*IntegrationTest.ts",
		"**/__tests__/**",
		"tests/**"
	]
	// Preserve Batshit's established $lib module contract alongside Vite's explicit alias.
	//
	// If you want to overwrite includes/excludes, make sure to copy over the relevant includes/excludes
	// from the referenced tsconfig.json - TypeScript does not merge them in
}
