{
	"name": "batshit-app",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-only",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "NODE_OPTIONS=--no-warnings NODE_NO_WARNINGS=1 vite dev",
		"build": "vite build && node scripts/copy-system-skills-to-build.mjs",
		"preview": "vite preview",
		"postinstall": "patch-package",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-style-conflicts.mjs",
		"check:styles": "node scripts/check-style-conflicts.mjs",
		"lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"test:redis": "VITEST_REDIS_URL=redis://127.0.0.1:6379/15 VITEST_USE_REAL_REDIS=true vitest run --pool=threads --maxWorkers=1",
		"test:memory": "VITEST_MEMORY_SEARCH=true VITEST_USE_REAL_REDIS=true vitest run --pool=threads --maxWorkers=1 src/lib/server/services/memory",
		"generate:brand-icons": "tsx scripts/generate-brand-icons.ts",
		"generate:file-icons": "tsx scripts/generate-file-icons.ts",
		"compare:model-catalog-sources": "tsx scripts/compare-model-catalog-sources.ts",
		"sync:model-catalog": "tsx scripts/sync-model-catalog.ts",
		"sync:compatibility-matrix": "tsx scripts/sync-compatibility-matrix.ts",
		"livekit:agent:install": "npm --prefix ../tools/livekit-agent-sidecar install",
		"livekit:agent:dev": "npm --prefix ../tools/livekit-agent-sidecar run dev",
		"livekit:agent:start": "npm --prefix ../tools/livekit-agent-sidecar run start"
	},
