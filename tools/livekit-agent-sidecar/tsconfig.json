{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["../../batshit-app/src/lib/*.ts", "../../batshit-app/src/lib/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
