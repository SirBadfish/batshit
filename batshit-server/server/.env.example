# Batshit-Server Environment Variables

# Shared internal service token. Use the same value as Batshit app and n8n tools.
BATSHIT_TOKEN=replace-with-a-long-random-token
BATSHIT_ARTIFACT_COMPLETE_URL=http://localhost:5621/api/artifacts/complete

# Redis Stack / RedisJSON
REDIS_URL=redis://localhost:6379/0
BATSHIT_REDIS_REQUIRED=false

# HTTP runtime
BATSHIT_SERVER_HOST=127.0.0.1
PORT=5610
ENABLE_HTTPS=false
HTTPS_ONLY=false
UPLOADS_DIR=./uploads
BATSHIT_BACKUP_STAGING_DIR=./data/backup-restore-staging

# Optional provider env fallback. Settings -> API Keys is preferred.
ANTHROPIC_API_KEY=
