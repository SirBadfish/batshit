    {
      "parameters": {
        "toolDescription": "Delegate to the assigned n8n Subnode Subagent. Use this dedicated subagent tool when the user asks you to hand work to n8n Subnode Subagent; do not use Batshit Tools or native_skill as a substitute for this handoff.",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prompt__User_Message_', ``, 'string') }}",
        "options": {
          "systemMessage": "={{ $json.body.subagentPrompts.n8n_subnode_subagent }}",
          "returnIntermediateSteps": true,
          "passthroughBinaryImages": true
        }
