      "id": "48da5422-7806-4e7f-bdbd-fbef5c22d29f",
      "name": "n8n Subnode Subagent"
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "This node gives an explicitly wired n8n Subnode Subagent access to Batshit native tool actions. Pick the action first, then send that action's payload in `input`.\n\nUse:\n- `native_skill` for Batshit Skills & Prompts\n- `batshit_tool_search` / `batshit_tool_use` for assigned MCP tools, saved CLI Tools, Agent Browser, and published Artifact Runtime Tools\n- `runtime_addon_list` / `runtime_addon_status` / `runtime_addon_prepare` / `runtime_addon_start` / `runtime_addon_stop` for runtime add-ons\n- `web_search` for Batshit web search\n- `bash_execute` for command execution\n\nImportant: for `batshit_tool_use`, use the exact result reference returned by `batshit_tool_search`. `fetch_zip` is not available for subagent runs, and broad Fabric control-plane actions are Primary-Agent-only.",
        "method": "POST",
        "url": "={{ (($json.body.batshit_frontend_url || $json.body.batshitFrontendUrl || $env.BATSHIT_FRONTEND_URL || 'http://app:3000').replace(/\\/$/, '')) + '/api/native-tools/dispatch' }}",
        "authentication": "none",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-batshit-user-id",
              "value": "={{ String($json.body.user_id).toLowerCase() }}"
            },
            {
              "name": "x-batshit-native-tool-token",
              "value": "={{ $json.body.batshit_native_tool_token || $json.body.batshitNativeToolToken || $json.body.batshit_sse_callback_token || $json.body.batshitSseCallbackToken || '' }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {\n  userId: String($json.body.user_id).toLowerCase(),\n  action: $fromAI('action', 'One Batshit native action to run: bash_execute, native_skill, batshit_tool_search, batshit_tool_use, web_search, runtime_addon_list, runtime_addon_status, runtime_addon_prepare, runtime_addon_start, or runtime_addon_stop. Do not use fetch_zip from subagent context.', 'string'),\n  input: $fromAI('input', 'JSON object payload for the selected action. Use an empty object when the action needs no payload.', 'json'),\n  context: {\n    session_id: $json.body.session_id,\n    message_id: $json.body.message_id || $json.body.messageId,\n    agent_id: 'n8n_subnode_subagent',\n    primary_agent_type: 'n8n',\n    actor_type: 'subagent',\n    parent_agent_id: $json.body.agent_id\n  }\n} }}",
        "options": {
          "timeout": 300000
        },
        "optimizeResponse": true,
        "responseType": "json",
        "fieldsToInclude": "all"
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        912,
